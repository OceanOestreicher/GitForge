{
  "name": "gitforge",
  "version": "1.0.0",
  "private": true,
  "description": "A Windows desktop Git client",
  "main": "electron/main.cjs",
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:messages && tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "playwright test",
    "build:messages": "node scripts/build-messages.cjs",
    "pretest": "npm run build:messages",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "test:packaged": "node scripts/test-packaged.cjs"
  },
  "build": {
    "appId": "com.gitforge.desktop",
    "productName": "GitForge",
    "directories": { "output": "release" },
    "files": ["electron/**/*.cjs", "dist/**/*", "dist-electron/messages.cjs", "assets/gitforge.ico"],
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "artifactName": "GitForge.${ext}",
    "win": { "icon": "assets/gitforge.ico", "target": [{ "target": "portable", "arch": ["x64"] }] }
  }
}
